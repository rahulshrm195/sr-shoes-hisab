rules_version = '2';

// SR Shoes Hisab — Firestore security rules (app v1.11.0+)
// Paste into Firebase console → Firestore Database → Rules → Publish.
//
// The app only hides things on screen. These rules are what actually stop
// a staff login — even one using browser developer tools — from reading
// or changing what it should not.
//
// Staff, in short:
//   • can work only on TODAY's register, and cannot read any other day
//   • can only ADD expense / cash-in / post-closing entries, never edit or remove
//   • cannot change the opening once saved, or anything once the day is closed
//   • cannot see today's expected opening until their own count is saved
//   • cannot set or change a supplier's opening balance
//   • can only add supplier transactions dated today, never edit or delete
//   • cannot touch the activity log (nobody can change or delete it)

service cloud.firestore {
  match /databases/{database}/documents {

    function storeId() { return 'sr-shoes-main'; }

    function signedIn() { return request.auth != null; }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A user who has a user record for this store
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().storeId == storeId();
    }

    function isOwner() { return isMember() && me().role == 'owner'; }

    // Fields that this write adds, removes or changes
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Dates, in India time. d is 'YYYY-MM-DD' ──────────
    function dayStart(d) {
      return timestamp.date(int(d[0:4]), int(d[5:7]), int(d[8:10]));
    }
    function nowIST() { return request.time + duration.value(330, 'm'); }
    function isToday(d) {
      return nowIST() >= dayStart(d) && nowIST() < dayStart(d) + duration.value(24, 'h');
    }
    function isTomorrow(d) {
      return nowIST() >= dayStart(d) - duration.value(24, 'h') && nowIST() < dayStart(d);
    }

    function regPath(d) {
      return /databases/$(database)/documents/registers/$(storeId() + '_' + d);
    }

    // ── USERS ────────────────────────────────────────────
    match /users/{uid} {
      allow get:  if signedIn() && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();

      // First login: a user creates their own record.
      // Always as staff, unless the owner has pre-approved this email.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.storeId == storeId()
        && request.resource.data.email == request.auth.token.email
        && (
          request.resource.data.role == 'staff'
          || (
            exists(/databases/$(database)/documents/pendingUsers/$(request.auth.token.email))
            && get(/databases/$(database)/documents/pendingUsers/$(request.auth.token.email)).data.role
               == request.resource.data.role
          )
        );

      // Owner may change a user's role. Nobody can change their own role.
      allow update: if
        (isOwner()
          && changed().hasOnly(['role'])
          && request.resource.data.role in ['owner', 'staff'])
        || (request.auth.uid == uid
          && isMember()
          && changed().hasOnly(['fcmToken']));

      allow delete: if isOwner();
    }

    // ── PENDING USERS (owner pre-approves an email, doc id = email) ──
    match /pendingUsers/{email} {
      allow get:    if signedIn() && (request.auth.token.email == email || isOwner());
      allow list:   if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.storeId == storeId()
        && request.resource.data.role in ['owner', 'staff'];
      allow delete: if signedIn() && (request.auth.token.email == email || isOwner());
    }

    // ── SETTINGS ─────────────────────────────────────────
    match /settings/{id} {
      allow read: if isMember();
      // Owner: anything. Staff: only the reminder time and low-cash alert.
      allow create: if isOwner();
      allow update: if isOwner()
        || (isMember() && changed().hasOnly(['eodTime', 'lowCashAlert']));
      allow delete: if false;
    }

    // ── DAILY REGISTERS ──────────────────────────────────
    match /registers/{regId} {

      function validShape() {
        return request.resource.data.storeId == storeId()
          && request.resource.data.date is string
          && request.resource.data.date.size() == 10
          && regId == storeId() + '_' + request.resource.data.date;
      }

      function openingKeys() {
        return ['openingCash', 'openingCounts', 'openingNotes', 'countedBy',
                'openingTime', 'mismatchReason'];
      }
      function closingKeys() {
        return ['closingCash', 'closingCounts', 'totalSales', 'phonepe', 'cardSales',
                'cashSales', 'takenHome', 'closedBy', 'expenseTotal', 'cashInTotal',
                'closingTime'];
      }

      // The new list is the old list plus exactly ONE new entry at the end,
      // stamped with this user and the current time.
      function appendedOne(oldList, newList) {
        return newList is list
          && newList.size() == oldList.size() + 1
          && (oldList.size() == 0 || newList[0:oldList.size()] == oldList)
          && newList[oldList.size()].byUid == request.auth.uid
          && newList[oldList.size()].amt is number
          && newList[oldList.size()].amt > 0
          && newList[oldList.size()].atMs is number
          && newList[oldList.size()].atMs > request.time.toMillis() - 600000
          && newList[oldList.size()].atMs < request.time.toMillis() + 600000;
      }

      function lastOf(l) { return l[l.size() - 1]; }

      // What a STAFF login may write. old = the record before this write ({} if new).
      function staffWriteOk(old, keys) {
        let new = request.resource.data;
        return isToday(new.date)
          && new.updatedAt == request.time
          // never the expected opening, never anything outside the known fields
          && !keys.hasAny(['expectedOpening'])
          && keys.hasOnly(openingKeys().concat(closingKeys())
               .concat(['date', 'storeId', 'updatedAt', 'expenses', 'cashIn', 'postClosing', 'pcCashTotal']))
          && (
            old.get('closingTime', null) != null
              // ── Day already closed: only ADD a post-closing entry ──
              ? (
                  keys.hasOnly(['postClosing', 'pcCashTotal', 'updatedAt'])
                  && appendedOne(old.get('postClosing', []), new.postClosing)
                  && new.pcCashTotal == old.get('pcCashTotal', 0)
                       + (lastOf(new.postClosing).get('type', 'cash') != 'online' ? lastOf(new.postClosing).amt : 0)
                )
              // ── Day still open ──
              : (
                  // Opening: can be saved once, then it is locked
                  (old.get('openingTime', null) == null || !keys.hasAny(openingKeys()))
                  // Expenses and cash-in: untouched, or exactly one added
                  && (!keys.hasAny(['expenses']) || appendedOne(old.get('expenses', []), new.expenses))
                  && (!keys.hasAny(['cashIn'])   || appendedOne(old.get('cashIn', []),   new.cashIn))
                  // Post-closing entries only exist after closing
                  && !keys.hasAny(['postClosing', 'pcCashTotal'])
                  // Closing: all-or-nothing, with a closing time
                  && (!keys.hasAny(closingKeys())
                      || (new.get('closingTime', null) != null && new.closingCash is number && new.takenHome is number))
                )
          );
      }

      // Staff may open ONLY today's register; the owner pulls any day or range.
      // regId is 'sr-shoes-main_YYYY-MM-DD'
      allow get:  if isOwner() || (isMember() && regId.size() == 24 && isToday(regId[14:24]));
      allow list: if isOwner();

      allow create: if isMember() && validShape()
        && (isOwner() || staffWriteOk({}, request.resource.data.keys().toSet()));

      allow update: if isMember() && validShape()
        && (isOwner() || staffWriteOk(resource.data, changed()));

      allow delete: if isOwner();
    }

    // ── EXPECTED OPENING ("carry forward"), one record per day ──
    // Kept apart from the register so the opening count stays blind.
    match /carry/{carryId} {

      function regAfter(d) { return getAfter(regPath(d)).data; }

      // Staff may read today's figure only AFTER their opening count is saved
      allow get: if isOwner()
        || (isMember()
            && carryId.size() == 24 && isToday(carryId[14:24])
            && exists(regPath(carryId[14:24]))
            && get(regPath(carryId[14:24])).data.get('openingTime', null) != null);
      allow list: if isOwner();

      // Staff may write only TOMORROW's figure, and only the exact amount
      // that today's closed register works out to.
      allow create, update: if isMember()
        && request.resource.data.storeId == storeId()
        && carryId == storeId() + '_' + request.resource.data.date
        && (isOwner()
          || (
            isTomorrow(request.resource.data.date)
            && isToday(request.resource.data.fromDate)
            && request.resource.data.byUid == request.auth.uid
            && request.resource.data.at == request.time
            && request.resource.data.keys().hasOnly(['date', 'fromDate', 'storeId', 'amount', 'byUid', 'at'])
            && regAfter(request.resource.data.fromDate).get('closingTime', null) != null
            && request.resource.data.amount ==
                 regAfter(request.resource.data.fromDate).closingCash
                 - regAfter(request.resource.data.fromDate).takenHome
                 + regAfter(request.resource.data.fromDate).get('pcCashTotal', 0)
          ));

      allow delete: if isOwner();
    }

    // ── SUPPLIERS ────────────────────────────────────────
    match /suppliers/{id} {
      allow read: if isMember();

      // Staff may add a supplier, but only with a zero opening balance
      allow create: if isMember() && request.resource.data.storeId == storeId()
        && (isOwner() || request.resource.data.get('openingBalance', 0) == 0);

      // Staff may correct contact details only — never the opening balance
      allow update: if isMember() && request.resource.data.storeId == storeId()
        && (isOwner() || changed().hasOnly(['name', 'phone', 'city', 'notes', 'updatedAt']));

      allow delete: if isOwner();
    }

    match /supplier_txns/{id} {
      allow read: if isMember();

      // Staff: today's date only, stamped with who and when, a real supplier
      allow create: if isMember() && request.resource.data.storeId == storeId()
        && (isOwner()
          || (
            request.resource.data.byUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.amount is number
            && request.resource.data.amount > 0
            && request.resource.data.date is string
            && request.resource.data.date.size() == 10
            && isToday(request.resource.data.date)
            && request.resource.data.type in ['purchase', 'payment', 'part_payment', 'return',
                                             'advance', 'debit_note', 'credit_note']
            && exists(/databases/$(database)/documents/suppliers/$(request.resource.data.supplierId))
            // Staff can pay from the shop drawer or the bank — never from home cash
            && request.resource.data.get('paidFrom', 'shop') in ['shop', 'bank']
          ));

      allow update: if isOwner() && request.resource.data.storeId == storeId();
      allow delete: if isOwner();
    }

    // ── CASH & BANK (owner only) ─────────────────────────
    match /money_config/{id} {
      allow read: if isOwner();
      allow create, update: if isOwner() && id == storeId()
        && request.resource.data.storeId == storeId();
      allow delete: if false;
    }

    // Movements are write-once: a mistake is fixed with an opposite entry
    match /money_moves/{id} {
      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.storeId == storeId()
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    // ── ACTIVITY LOG ─────────────────────────────────────
    // Write-once. Nobody — not even the owner — can change or delete an entry.
    match /audit/{id} {
      allow read: if isOwner();
      allow create: if isMember()
        && request.resource.data.storeId == storeId()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ── PUSH NOTIFICATION DEVICES ────────────────────────
    // Written by the app, read only by server-side code.
    match /fcm_tokens/{devId} {
      allow read: if isOwner();
      allow create, update: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.storeId == storeId();
      allow delete: if isOwner();
    }

    // Anything not listed above is denied.
  }
}
